# Copy to .env for local dev. On Railway, set these as service environment
# variables instead — never commit real values (future-proofing item 3).

# Postgres — Railway injects this automatically when you attach its managed
# Postgres plugin to this service.
DATABASE_URL=postgres://user:password@localhost:5432/family_app
PGSSL=false

# Session cookie signing secret — any long random string.
SESSION_SECRET=change-me

# Google OAuth (Calendar API enabled on the project)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Meta WhatsApp Cloud API — permanent System User token, not a 24h user token
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
WHATSAPP_DISPLAY_NUMBER=

# LLM extraction call
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Where the React app is served from, for OAuth redirects in dev
WEB_APP_URL=http://localhost:5173

PORT=3000
